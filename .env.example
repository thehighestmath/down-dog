# Нужен только для локального запуска s3/s3.py вне Docker.
# В docker compose эти значения уже заданы в docker-compose.yml.
# Скопируйте в .env (он в .gitignore) и поправьте при необходимости.
POSTGRES_PASSWORD = postgres
ACCESS_KEY = minioadmin
SECRET_KEY = minioadmin
POSTGRES_USER = postgres
POSTGRES_DB = app_db
MINIO_ROOT_USER = minioadmin
MINIO_ROOT_PASSWORD = minioadmin
BUCKET_NAME = down-dog
CORS_ORIGINS=https://yoga.pet-projects.pro
FRONTEND_PORT=3000
ADMINER_PORT=8080
DOMAIN=yoga.pet-projects.pro
COMPOSE_FILE=docker-compose.prod.yml
