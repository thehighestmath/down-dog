# Нужен только для локального запуска s3/s3.py вне Docker.
# В docker compose эти значения уже заданы в docker-compose.yml.
# Скопируйте в .env (он в .gitignore) и поправьте при необходимости.
POSTGRES_PASSWORD = postgres
ACCESS_KEY = minioadmin
SECRET_KEY = minioadmin
POSTGRES_USER = postgres
POSTGRES_DB = app_db
MINIO_ROOT_USER = minioadmin
MINIO_ROOT_PASSWORD = minioadmin
BUCKET_NAME = down-dog
CORS_ORIGINS = https://down-dog.example.com, https://localhost
